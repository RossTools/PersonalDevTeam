---
// /plugins/media/: the media plugins (Scryer, Plex, Sonarr and Radarr), apart from the main Plugins page (PDT-281).
import Landing from '../../layouts/Landing.astro';
import PluginCatalog from '../../components/PluginCatalog.astro';
import { PLUGINS, pluginsOn } from '../../plugins.mjs';
import { siteLinks } from '../../links.mjs';

const links = siteLinks(import.meta.env.BASE_URL);
---

<Landing title="Media plugins · PDT" description="PDT's media plugins: media servers and managers, as workflow steps and tools for the PM.">
	<main><div class="wrap">
	<div class="kicker"><a href={links.plugins}>// plugins</a> / media</div>
	<h1>Media plugins</h1>
	<p class="lead">
		PDT's workflows and its PM can look after a media library too: search and add films and series, read download
		queues and refresh a media server.
	</p>
	<div class="actions">
		<a class="btn sm ghost" href={links.requestPlugin}>Request a plugin</a>
	</div>
	<PluginCatalog plugins={pluginsOn(PLUGINS, true)} />
	<p class="also"><a href={links.plugins}>All the other plugins</a></p>
	</div></main>
</Landing>

<style>
	main { padding: 64px 0 96px; }
	h1 { margin: 0; max-width: none; font-size: clamp(34px, 5vw, 48px); line-height: 1.1; letter-spacing: -.02em; font-weight: 700; }
	.kicker a:hover, .also a:hover { text-decoration: underline; }
	.also a { color: var(--accent-hi); }
	.actions { margin-top: 20px; }
	.also { margin-top: 40px; font-size: 14px; }
</style>
