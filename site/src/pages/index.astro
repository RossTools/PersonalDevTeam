---
// The landing page (design: the pdt-site-mockup's index.html). It stands outside Starlight; the docs are under /docs/.
import '../styles/fonts.css';
import '../styles/site.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { Image } from 'astro:assets';
// Screenshots of a made-up sample project, regenerated by scripts/site-screenshots.mjs (site/README.md).
import boardShot from '../assets/screens/board.webp';
import workspacesShot from '../assets/screens/workspaces.webp';
import backlogShot from '../assets/screens/backlog.webp';
import workflowsShot from '../assets/screens/workflows.webp';
import { repoStats } from '../stats.mjs';
import { siteLinks } from '../links.mjs';

const links = siteLinks(import.meta.env.BASE_URL);
const base = links.root;
const stats = repoStats();
const shots = [
	{
		src: workspacesShot,
		title: 'Every agent in one place',
		text: 'Sessions and runs sit beside the work. Read an agent\'s conversation, its tool calls and its diff; the sidebar shows who is working and who needs you.',
		alt: 'The Sessions view: a Coder agent\'s conversation, with the tool calls it made and its summary, beside a list of agents marked Ended, Working and Needs you.',
	},
	{
		src: backlogShot,
		title: 'A backlog that knows what is in flight',
		text: 'Rank, group and filter tickets. Blocked tickets and changes that overlap work in progress are flagged before an agent starts.',
		alt: 'The ticket backlog grouped into Draft and Ready, with labels, priorities, a Blocked badge and an overlap warning.',
	},
	{
		src: workflowsShot,
		title: 'Workflows for the rest',
		text: 'Workflows react to events and schedules: file a ticket, start an agent, ask you in the Inbox. Build them as a graph.',
		alt: 'A workflow graph: every night at 3:00, list outdated packages; if any, file a ticket for the Coder and tell me, else nothing to do.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={`${base}pdt-favicon-16.svg`} type="image/svg+xml" />
		<title>PDT: a dev team that lives on your machine</title>
		<meta name="description" content="Write the ticket. Agents build it in their own worktrees, review it, test it and open the PR. You approve what ships." />
	</head>
	<body>
		<SiteNav home />

		<header class="hero">
			<div class="grid-dots"></div>
			<div class="wrap" style="position:relative">
				<div class="eyebrow">{stats.version && <b>{stats.version}</b>} Open source · macOS, Windows & Linux</div>
				<h1>A dev team that lives <em>on your machine.</em></h1>
				<p class="sub">Write the ticket. Agents build it in their own worktrees, review it, test it and open the PR. You approve what ships.</p>
				<div class="cta">
					<a class="btn primary" href={links.download}>Download for macOS</a>
					<a class="btn ghost" href={links.docs}>Read the docs</a>
				</div>
				<div class="platforms">Also for Windows and Linux · Runs locally · Bring your own agent subscriptions</div>

				<div class="shot hero-shot">
					<Image
						src={boardShot}
						alt="PDT's board for a sample shop project: tickets in To do, Code, Review, QA, Accept, Merge and Done, with pull request and CI badges, one waiting for your Accept."
						widths={[640, 1040, 1600, 2080]}
						sizes="(max-width: 1088px) calc(100vw - 48px), 1040px"
						loading="eager"
					/>
				</div>
			</div>
		</header>

		<section id="how">
			<div class="wrap">
				<div class="kicker">// how it works</div>
				<h2>You write tickets. The team does the rest.</h2>
				<p class="lead">Every ticket runs through the same loop a good team uses. Each agent has one job, and nothing merges without you.</p>
				<div class="loop">
					<div class="step you"><div class="node"><div class="d"></div></div><b>You</b><span>Write a ticket, or ask the PM to draft one</span></div>
					<div class="step"><div class="node"><div class="d"></div></div><b>Coder</b><span>Builds it on its own branch and worktree</span></div>
					<div class="step"><div class="node"><div class="d"></div></div><b>Reviewer</b><span>Reads the diff and sends fixes back</span></div>
					<div class="step"><div class="node"><div class="d"></div></div><b>QA</b><span>Runs the branch and tries it for real</span></div>
					<div class="step"><div class="node"><div class="d"></div></div><b>PR + CI</b><span>Opens the PR and watches CI and conflicts</span></div>
					<div class="step you"><div class="node"><div class="d"></div></div><b>You</b><span>Approve and merge, or send it back</span></div>
				</div>
				<div class="loop-note"><span class="dot me"></span>The white dot is you. Trust a ticket? Label it <span class="mono">agentic</span> and it merges once QA passes.</div>
			</div>
		</section>

		<section id="features">
			<div class="wrap">
				<div class="kicker">// features</div>
				<h2>Everything a team needs, running on one machine.</h2>
				<div class="features">
					<div class="f"><div class="ic">▸_</div><h3>Sessions that outlive the window</h3><p>Agents run in terminals owned by a local daemon. Close the tab or restart, and they pick up where they left off.</p></div>
					<div class="f"><div class="ic">⑂</div><h3>A worktree per change</h3><p>Each ticket gets its own branch and worktree, so agents never trip over each other or over you.</p></div>
					<div class="f"><div class="ic">▶</div><h3>Run any branch in one click</h3><p>Start a dev build of any branch on its own port with its own data, and try the change yourself.</p></div>
					<div class="f"><div class="ic">±</div><h3>Review like a PR</h3><p>Read the diff, comment on a line, and the comment goes straight back to the agent.</p></div>
					<div class="f"><div class="ic">PM</div><h3>A project manager you can talk to</h3><p>Ask why a ticket is stuck, split an epic or draft a spec. The PM knows every project and every run.</p></div>
					<div class="f"><div class="ic">⌁</div><h3>From your phone</h3><p>The same UI works over Tailscale, so you can approve a PR from the couch.</p></div>
				</div>
				<div class="see">
					{shots.map((shot) => (
						<figure>
							<a class="shot" href={shot.src.src}>
								<Image src={shot.src} alt={shot.alt} widths={[640, 1040, 1600]} sizes="(max-width: 860px) calc(100vw - 48px), 780px" />
							</a>
							<figcaption><b>{shot.title}</b>{shot.text}</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<section>
			<div class="wrap">
				<div class="kicker">// bring your own agents</div>
				<h2>Use the agents you already pay for.</h2>
				<p class="lead">PDT runs the official CLIs with your own logins. No resold tokens, no middleman.</p>
				<div class="agents">
					<div class="agent"><div class="name"><span class="badge claude">C</span>Claude Code</div><code>claude auth login</code></div>
					<div class="agent"><div class="name"><span class="badge codex">◎</span>Codex</div><code>codex login</code></div>
					<div class="agent"><div class="name"><span class="badge devin">D</span>Devin</div><code>devin auth login</code></div>
				</div>
				<p class="muted" style="margin-top:20px;font-size:14px">More agents coming soon.</p>
			</div>
		</section>

		<section>
			<div class="wrap split">
				<div>
					<div class="kicker">// built inside PDT</div>
					<h2>PDT is built by PDT.</h2>
					<p class="lead">Every feature on this page went through PDT's own board: an agent took the ticket, built it in a worktree, tested it as a dev instance of PDT and opened the PR.</p>
					<div class="stats">
						<div class="stat"><b>{stats.tickets}</b><span>tickets</span></div>
						<div class="stat"><b>{stats.prs}</b><span>PRs merged</span></div>
						<div class="stat"><b>{stats.releases}</b><span>releases</span></div>
						<div class="stat"><b>1</b><span>human</span></div>
					</div>
				</div>
				<div class="term" aria-hidden="true">
					<div><span class="p">pdt</span> <span class="w">PDT-196</span> moved to <span class="y">In progress</span></div>
					<div><span class="p">coder</span> worktree <span class="w">.worktrees/pdt-PDT-196</span> ready</div>
					<div><span class="p">coder</span> 3 files changed, tests pass</div>
					<div><span class="p">reviewer</span> 1 comment → sent to coder</div>
					<div><span class="p">coder</span> fixed, pushed</div>
					<div><span class="p">qa</span> dev build on :7431, checked <span class="g">✓</span></div>
					<div><span class="p">github</span> PR #194 CI <span class="g">passed</span></div>
					<div><span class="p">pdt</span> waiting on <span class="w">you</span> to approve<span class="w cursor">▍</span></div>
				</div>
			</div>
		</section>

		<section>
			<div class="wrap split">
				<div class="term" aria-hidden="true">
					<div><span class="p">pdt</span> <span class="w">host</span></div>
					<div>pdtd        <span class="g">running</span>  127.0.0.1:7420</div>
					<div>version     0.2.0</div>
					<div>update      0.2.1 <span class="y">waiting for idle</span></div>
					<div>secrets     OS keychain</div>
					<div>remote      tailscale · owner only</div>
				</div>
				<div>
					<div class="kicker">// local first</div>
					<h2>Your code stays on your machine.</h2>
					<ul class="checks">
						<li><span><b>A daemon, not a cloud.</b> Everything runs on 127.0.0.1, and your repos never leave your disk.</span></li>
						<li><span><b>Secrets in the keychain.</b> Agents use your tokens without ever seeing them.</span></li>
						<li><span><b>Updates that roll back.</b> New releases install while you're idle, are health-checked, and revert if they fail.</span></li>
					</ul>
				</div>
			</div>
		</section>

		<section class="final">
			<div class="wrap">
				<img src={`${base}pdt-icon.svg`} alt="" width="72" height="72" class="icon" />
				<h2>Hire your dev team.</h2>
				<p class="lead">Free and open source. Bring your own agents.</p>
				<div class="cta">
					<a class="btn primary" href={links.download}>Download for macOS</a>
					<a class="btn ghost" href={links.download}>Download for Windows</a>
					<a class="btn ghost" href={links.download}>Download for Linux</a>
				</div>
			</div>
		</section>

		<SiteFooter />
	</body>
</html>

<style is:global>
  /* Hero */
  .hero { position: relative; padding: 96px 0 56px; text-align: center; overflow: hidden; }
  .hero .grid-dots { position: absolute; inset: 0; background-image: radial-gradient(circle, rgba(53,97,184,.18) 1.5px, transparent 1.6px); background-size: 28px 28px; mask-image: radial-gradient(ellipse at 50% 30%, #000 0%, transparent 65%); pointer-events: none; }
  .eyebrow { display: inline-flex; gap: 8px; align-items: center; font-size: 13px; color: var(--muted); border: 1px solid var(--border); border-radius: 99px; padding: 4px 12px 4px 6px; margin-bottom: 28px; background: var(--surface); }
  .eyebrow b { background: var(--accent-soft); color: var(--accent-hi); border-radius: 99px; padding: 1px 8px; font-weight: 500; }
  h1 { font-size: clamp(40px, 6vw, 68px); line-height: 1.05; letter-spacing: -.03em; font-weight: 700; max-width: 900px; margin: 0 auto; }
  h1 em { font-style: normal; color: var(--accent-hi); }
  .hero p.sub { font-size: 19px; color: var(--muted); max-width: 640px; margin: 22px auto 34px; }
  .cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .platforms { margin-top: 14px; font-size: 13px; color: var(--muted); }

  /* Screenshots */
  .shot { display: block; border: 1px solid var(--border); border-radius: 14px; background: var(--surface); overflow: hidden; box-shadow: 0 40px 120px rgba(53,97,184,.15), 0 0 0 1px rgba(255,255,255,.02); }
  .shot img { display: block; width: 100%; height: auto; }
  .hero-shot { margin: 64px auto 0; max-width: 1040px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 6px rgba(52,211,153,0); } }
  .see { display: grid; gap: 56px; margin-top: 80px; }
  .see figure { margin: 0; display: grid; grid-template-columns: 260px 1fr; gap: 40px; align-items: center; }
  .see .shot { order: 2; border-radius: var(--radius); box-shadow: 0 24px 80px rgba(53,97,184,.10); }
  .see figcaption { font-size: 15px; color: var(--muted); }
  .see figcaption b { display: block; color: var(--fg); font-size: 17px; font-weight: 600; margin-bottom: 6px; }

  /* Loop */
  .loop { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0; margin-top: 56px; position: relative; }
  .step { text-align: center; padding: 0 8px; position: relative; }
  .step .node { width: 56px; height: 56px; border-radius: 50%; margin: 0 auto 16px; display: grid; place-items: center; background: var(--accent-soft); border: 1px solid var(--accent); position: relative; z-index: 1; }
  .step .node .d { width: 14px; height: 14px; border-radius: 50%; background: var(--accent-hi); }
  .step.you .node { background: rgba(231,232,236,.08); border-color: var(--fg); }
  .step.you .node .d { background: var(--fg); }
  .step:not(:last-child)::after { content: ''; position: absolute; top: 28px; left: calc(50% + 28px); right: calc(-50% + 28px); height: 1px; background: linear-gradient(90deg, var(--accent), var(--border)); }
  .step b { display: block; font-size: 15px; margin-bottom: 4px; }
  .step span { font-size: 13px; color: var(--muted); line-height: 1.45; display: block; }
  .loop-note { margin-top: 40px; display: flex; gap: 10px; align-items: center; justify-content: center; font-size: 14px; color: var(--muted); }

  /* Features */
  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin-top: 56px; }
  .f { background: var(--bg); padding: 28px; }
  .f .ic { width: 36px; height: 36px; border-radius: 8px; background: var(--surface); border: 1px solid var(--border); display: grid; place-items: center; margin-bottom: 18px; font-family: var(--mono); font-size: 14px; color: var(--accent-hi); }
  .f h3 { font-size: 17px; font-weight: 600; margin-bottom: 6px; }
  .f p { font-size: 14.5px; color: var(--muted); }

  /* Agents */
  .agents { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 48px; }
  .agents .agent { border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; background: var(--surface); }
  .agents .agent .name { font-weight: 600; display: flex; align-items: center; gap: 10px; }
  .agents .agent .badge { width: 28px; height: 28px; border-radius: 7px; display: grid; place-items: center; font-weight: 700; font-size: 13px; }
  .agents .agent code { display: block; margin-top: 14px; font: 13px var(--mono); color: var(--muted); background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 8px 10px; }

  /* Split */
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .stat { border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; background: var(--surface); }
  .stat b { display: block; font-size: 34px; letter-spacing: -.02em; }
  .stat span { font-size: 13px; color: var(--muted); }
  .term { background: #0a0b0d; border: 1px solid var(--border); border-radius: var(--radius); padding: 18px 20px; font: 13px/1.8 var(--mono); color: var(--muted); }
  .term div { white-space: pre; }
  .term .p { color: var(--accent-hi); } .term .g { color: var(--running); } .term .y { color: var(--waiting); } .term .w { color: var(--fg); }
  ul.checks { list-style: none; padding: 0; margin-top: 28px; display: grid; gap: 12px; }
  ul.checks li { display: flex; gap: 12px; color: var(--muted); }
  ul.checks li::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--accent-hi); margin-top: 9px; flex: none; }
  ul.checks b { color: var(--fg); font-weight: 500; }

  /* Final CTA */
  .final { text-align: center; padding: 120px 0; }
  .final h2 { margin: 0 auto; }
  .final .cta { margin-top: 32px; }
  .dots7 { display: grid; grid-template-columns: repeat(3, 14px); gap: 10px; justify-content: center; margin-bottom: 32px; }
  .dots7 i { width: 14px; height: 14px; border-radius: 50%; background: var(--accent); opacity: .3; animation: work 3.5s infinite; }
  .dots7 i:nth-child(2){animation-delay:.3s} .dots7 i:nth-child(3){animation-delay:.6s} .dots7 i:nth-child(4){animation-delay:.9s} .dots7 i:nth-child(5){animation-delay:1.2s} .dots7 i:nth-child(6){animation-delay:1.5s}
  .dots7 i.me { background: var(--fg); opacity: 1; animation: none; grid-column: 3; }
  .dots7 i.gap { visibility: hidden; animation: none; }
  @keyframes work { 0%,100% { opacity: .3 } 40% { opacity: 1 } }


  /* Inline styles of the mockup, as classes. */
  .dot.me { background: var(--fg); }
  .cursor { animation: pulse 1s infinite; }
  .agent .badge.claude { background: rgba(217,119,87,.15); color: var(--claude); }
  .agent .badge.codex { background: rgba(231,232,236,.08); }
  .agent .badge.devin { background: rgba(53,97,184,.15); color: var(--accent-hi); }
  .split .stats { margin-top: 32px; }
  .final .icon { display: block; margin: 0 auto 32px; }
  .final .lead { margin: 16px auto 0; }

  @media (max-width: 860px) {
    .loop { grid-template-columns: repeat(2, 1fr); row-gap: 40px; } .step::after { display: none; }
    .features, .agents { grid-template-columns: 1fr; }
    .see figure { grid-template-columns: 1fr; gap: 18px; } .see .shot { order: 0; }
    .split { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
