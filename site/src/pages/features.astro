---
// The Features page: one section per area of PDT, each with what it gives you, a screenshot and its user docs. Like
// the landing page it stands outside Starlight. The wording follows the user docs: claim only what ships.
import { Image } from 'astro:assets';
import Landing from '../layouts/Landing.astro';
import InstallBox from '../components/InstallBox.astro';
// Screenshots of a made-up sample project, regenerated by scripts/site-screenshots.mjs (site/README.md).
import boardShot from '../assets/screens/board.webp';
import ticketShot from '../assets/screens/ticket.webp';
import workspacesShot from '../assets/screens/workspaces.webp';
import reviewShot from '../assets/screens/review.webp';
import workflowsShot from '../assets/screens/workflows.webp';
import pmShot from '../assets/screens/pm.webp';
import inboxShot from '../assets/screens/inbox.webp';
import phoneShot from '../assets/screens/phone.webp';
import secretsShot from '../assets/screens/secrets.webp';
import { siteLinks } from '../links.mjs';

const links = siteLinks(import.meta.env.BASE_URL);

// Each area: `id` is its anchor (the landing page's feature cards link to them), `docs` its user docs page, `more`
// further docs pages, and `shots` its screenshots (`narrow` for a tall one, a phone's or a panel's, shown narrow beside
// the other).
const areas = [
	{
		id: 'tickets',
		kicker: 'tickets and the board',
		title: 'Write the ticket. Agents take it from there.',
		text: 'A ticket says what should change and how you\'ll know it\'s done. Put tickets in order and start them, or let the project start them for you. The board shows who has each one, and what waits for you.',
		points: [
			['A backlog and a board.', 'Rank what\'s not picked yet, then follow To do, In progress and Done, each card with its pull request and CI.'],
			['Parts for big work.', 'Split a ticket into parts, each started, reviewed and merged on its own, in order.'],
			['Priorities, labels and blockers.', 'A blocked ticket waits, and tickets that would change the same code are flagged before they start.'],
			['Auto-start.', 'The project starts its next ticket, by priority or by rank, whenever it has room under its cap.'],
		],
		docs: ['Tickets and the board', 'using-pdt/tickets-and-the-board'],
		shots: [
			{ src: boardShot, alt: 'The board of a sample shop project: tickets in To do, Code, Review, QA, Accept, Merge and Done, with pull request and CI badges.' },
			{ narrow: true, src: ticketShot, alt: 'A ticket: a part of the Checkout v2 ticket, in QA, with its branch, change request, passing CI, its QA agent and the tickets it blocks.' },
		],
	},
	{
		id: 'agents',
		kicker: 'agents and sessions',
		title: 'Bring your own agents, and keep them running.',
		text: 'PDT runs the agents you already use, signed in with your own subscriptions. Every session lives in a daemon on your machine, beside the tickets, runs and changes it belongs to.',
		points: [
			['Claude Code, Codex, Devin, Grok, Cursor, OhMyPi and Antigravity,', 'and any other agent that speaks the Agent Client Protocol (ACP).'],
			['A conversation or a terminal.', 'Read messages, tool calls and each edit\'s diff, or use the agent\'s own terminal. Switch whenever you like.'],
			['Sessions that survive restarts.', 'Conversations keep their whole history; terminals start again on the same conversation.'],
			['A worktree per change.', 'Each ticket gets its own branch and worktree, and Run starts a dev server or the tests for any branch on its own port.'],
		],
		docs: ['Workspaces and sessions', 'using-pdt/workspaces-and-sessions'],
		shots: [
			{ src: workspacesShot, alt: 'The Sessions view: a ticket\'s workspace open on its Coder agent\'s conversation, with the tool calls it made and its summary, beside the sidebar\'s ticket workspaces with their pull request and CI badges, marked Working and Needs you, and the user\'s own agents.' },
		],
	},
	{
		id: 'review',
		kicker: 'review and merge',
		title: 'Review like a pull request. Your comments go straight to the agent.',
		text: 'The Changes view shows a branch\'s diff file by file. Comment on a line, send your comments, and the agent working on the branch gets them and goes back to work.',
		points: [
			['A PR-style diff.', 'Split or unified, file by file, with Viewed to keep your place.'],
			['Line comments back to the agent.', 'Drafts until you Send feedback, then one message with the file and lines of each. Threads stay on their lines as the code changes.'],
			['Approve and merge.', 'Turn on auto-merge or add it to the merge queue on GitHub, or merge on your machine.'],
			['CI and conflicts watched for you.', 'A failed run, a conflict or a drop from the merge queue goes to the agent to fix; with no agent on it, to you.'],
		],
		docs: ['Review and merge', 'using-pdt/review-and-merge'],
		shots: [
			{ src: reviewShot, alt: 'The Changes view of a branch: a split diff of src/cart.js, with a line comment on how two carts\' quantities are merged, and Send feedback, Approve and Merge buttons.' },
		],
	},
	{
		id: 'workflows',
		kicker: 'workflows',
		title: 'A team process that runs itself.',
		text: 'Workflows act when something happens. The Pipeline hands each ticket from a Coder to a Reviewer to QA, then to you, then to merge. Others tell agents when CI fails, triage new issues, or run every night.',
		points: [
			['Coder → Reviewer → QA.', 'The Pipeline\'s stages each have their agent (or you), and send work back with notes when it isn\'t right.'],
			['Templates', 'for CI and pull requests, tickets, issues, notifications and releases, or start from scratch.'],
			['A visual builder.', 'Triggers, steps, conditions and gates that ask you in the Inbox, as a graph. Try one with a dry run.'],
			['Triggers and plugins.', 'Ticket and pull request events, new GitHub issues and pull requests, schedules and webhooks; plugins such as Jira and Discord add their own.'],
		],
		docs: ['Workflows', 'automation/workflows'],
		more: [['Plugins and connections', 'automation/plugins']],
		shots: [
			{ src: workflowsShot, alt: 'A workflow graph: every night at 3:00, list outdated packages; if any, file a ticket for the Coder and tell me, else nothing to do.' },
		],
	},
	{
		id: 'pm',
		kicker: 'the PM',
		title: 'A project manager you can talk to.',
		text: 'The PM is an agent you talk to about the work rather than the code. It sees every project, its tickets and what\'s in flight, and it plans, writes and tidies tickets for you.',
		points: [
			['"What needs me?"', 'It reads the board, pull requests and CI, running agents and the Inbox, and tells you.'],
			['Plans into tickets.', 'Describe a feature; it drafts the tickets, split into parts and linked in order, and creates them once you agree.'],
			['Acts across projects.', 'It messages an agent, runs a workflow, or writes one for you to accept.'],
			['Asks before it acts.', 'Before it changes a ticket, messages an agent or runs a workflow, it shows you a card to allow or deny. Reading never stops you.'],
		],
		docs: ['The PM', 'automation/the-pm'],
		shots: [
			{ src: pmShot, alt: 'A PM conversation: asked "What needs me today?", the PM lists a ticket waiting for Accept, an agent\'s question and a QA agent waiting on a permission, and suggests starting an urgent bug next.' },
		],
	},
	{
		id: 'phone',
		kicker: 'your phone',
		title: 'Your team, from your phone.',
		text: 'PDT\'s page fits a phone. Reach it over Tailscale wherever you are, and answer what waits for you in a minute between other things.',
		points: [
			['The same app, over Tailscale.', 'Only you can reach it on your tailnet, and no port is opened to the internet.'],
			['The Inbox.', 'Agents\' questions, sessions waiting on a permission, and tickets ready for your Accept, in one list.'],
			['Approvals on the go.', 'Review all steps through them one at a time, with the choices in a bar at the bottom.'],
			['Phone layouts', 'for tickets, the board and reviews, and a key bar for terminals.'],
		],
		docs: ['Remote access and your phone', 'your-machine/remote-access'],
		more: [['The Inbox', 'using-pdt/the-inbox']],
		shots: [
			{ src: inboxShot, alt: 'The Inbox: an agent\'s question with its suggested answers, beside a list of what needs you: a question, a session waiting, an unheard CI notice and a ticket ready to accept.' },
			{ src: phoneShot, alt: 'The Inbox on a phone: questions, sessions waiting, notices and a ticket ready to accept, with a Review all button.', narrow: true },
		],
	},
	{
		id: 'safe',
		kicker: 'safe by default',
		title: 'Agents do the work. You keep control.',
		text: 'Agents get room to work, and the guard rails stay where they matter: on your code, on what merges, on your keys and on text from people you don\'t know.',
		points: [
			['Every change on its own branch.', 'Each ticket is built in its own worktree, away from your checkout and the base branch.'],
			['Nothing merges without you,', 'unless you say so. Tickets wait for your Accept; the agentic label, and each project\'s rules on who merges, approvals and green CI, are yours to set.'],
			['Secrets agents never see.', 'Kept in your keychain and used by name; PDT puts the value in only where it\'s needed, and hides it wherever it stores, shows or logs text.'],
			['Outside issues and PRs kept untrusted.', 'The agents that read them are locked down, their text reaches them as data, never instructions, and only you can make their tickets agentic.'],
		],
		docs: ['Personas and approvals', 'automation/personas-and-approvals'],
		more: [['Secrets', 'your-machine/secrets'], ['Outside contributions', 'automation/outside-contributions']],
		shots: [
			{ src: secretsShot, alt: 'Settings, Secrets: three secrets kept in the system keyring, each with what it\'s for and who may use it, and none of their values.' },
		],
	},
];
---

<Landing
	title="Features"
	description="What PDT does, area by area: tickets and the board, your own agents, review and merge, workflows, the PM, your phone, safety and running locally."
>
	<header class="hero features-hero">
		<div class="grid-dots"></div>
		<div class="wrap" style="position:relative">
			<div class="kicker">// features</div>
			<h1>Everything a team needs, <em>on one machine.</em></h1>
			<p class="sub">Tickets, agents, review, workflows and a project manager, working together on your own computer. Here is what each part does for you.</p>
			<ul class="toc">
				{areas.map((a) => <li><a href={`#${a.id}`}>{a.kicker}</a></li>)}
				<li><a href="#local">runs locally</a></li>
			</ul>
		</div>
	</header>

	{areas.map((a) => (
		<section id={a.id} class="area">
			<div class="wrap">
				<div class="area-head">
					<div>
						<div class="kicker">// {a.kicker}</div>
						<h2>{a.title}</h2>
						<p class="lead">{a.text}</p>
						<p class="docs-links">
							<a class="btn sm ghost" href={links.doc(a.docs[1])}>Read the docs: {a.docs[0]} →</a>
							{a.more?.map(([label, path]) => <a href={links.doc(path)}>{label}</a>)}
						</p>
					</div>
					<ul class="checks">
						{a.points.map(([lead, rest]) => <li><span><b>{lead}</b> {rest}</span></li>)}
					</ul>
				</div>
				<div class:list={['area-shots', { 'with-narrow': a.shots.some((s) => s.narrow) }]}>
					{a.shots.map((s) => (
						<a class:list={['shot', { narrow: s.narrow }]} href={s.src.src}>
							<Image
								src={s.src}
								alt={s.alt}
								widths={s.narrow ? [300, 600, 900] : [640, 1040, 1600, 2080]}
								sizes={s.narrow ? '(max-width: 860px) 280px, 300px' : a.shots.length > 1 ? '(max-width: 860px) calc(100vw - 48px), 750px' : '(max-width: 1168px) calc(100vw - 48px), 1072px'}
							/>
						</a>
					))}
				</div>
			</div>
		</section>
	))}

	<section id="local" class="area">
		<div class="wrap split">
			<div>
				<div class="kicker">// runs locally</div>
				<h2>Your machine, your subscriptions.</h2>
				<p class="lead">PDT is a small daemon on your own computer, not a cloud service. Your code, tickets and history stay on your disk, and your agents run with your own logins.</p>
				<ul class="checks">
					<li><span><b>A daemon, not a cloud.</b> It answers on 127.0.0.1, and your repositories never leave your disk.</span></li>
					<li><span><b>Your subscriptions.</b> PDT runs the agents' official CLIs with your own logins: no resold tokens, no middleman.</span></li>
					<li><span><b>Updates with rollback.</b> Each release is checked against its checksums, health-checked once installed, and rolled back with your data as it was if it fails.</span></li>
					<li><span><b>macOS, Windows and Linux.</b> PDT starts when you log in, with a tray icon to open, update or restart it.</span></li>
				</ul>
				<p class="docs-links">
					<a class="btn sm ghost" href={links.doc('your-machine/updates')}>Read the docs: Running and updating PDT →</a>
					<a href={links.doc('your-machine/your-data')}>Your data</a>
				</p>
			</div>
			<div class="term" aria-hidden="true">
				<div><span class="p">update</span> downloading v0.4.1</div>
				<div><span class="p">update</span> checksums <span class="g">✓</span></div>
				<div><span class="p">update</span> database copied</div>
				<div><span class="p">update</span> installed, starting</div>
				<div><span class="p">update</span> health check <span class="y">failed</span></div>
				<div><span class="p">update</span> rolled back to <span class="w">v0.4.0</span>, data as it was</div>
				<div><span class="p">pdt</span> running on <span class="w">127.0.0.1</span><span class="w cursor">▍</span></div>
			</div>
		</div>
	</section>

	<section class="final">
		<div class="wrap">
			<img src={`${links.home}pdt-icon.svg`} alt="" width="72" height="72" class="icon" />
			<h2>Hire your dev team.</h2>
			<p class="lead">Free and open source. Bring your own agents.</p>
			<InstallBox id="install" />
			<div class="cta">
				<a class="btn primary" href={links.download} data-download-label>Download PDT</a>
				<a class="btn ghost" href={links.doc('getting-started/what-is-pdt')}>Get started</a>
			</div>
		</div>
	</section>
</Landing>
