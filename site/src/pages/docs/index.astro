---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { LinkCard, CardGrid } from '@astrojs/starlight/components';
import { USER_SECTIONS, docId } from '../../docs-pages.mjs';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const page = (id: string) => `${base}${id}/`;
---

<StarlightPage frontmatter={{ title: 'PDT docs', description: 'How to install PDT and get work done with it.' }}>
	<p>
		PDT (Personal Dev Team) runs coding agents on your machine. You write tickets; agents build them in their own
		worktrees, and you review and approve what ships. New here? Start with
		<a href={page(docId('user/getting-started/what-is-pdt.md'))}>What PDT is</a>, then
		<a href={page(docId('user/getting-started/install.md'))}>install it</a>.
	</p>
	<CardGrid>
		{USER_SECTIONS.map((s) => (
			<LinkCard title={s.label} description={s.summary} href={page(docId(`user/${s.dir}/${s.pages[0]}.md`))} />
		))}
	</CardGrid>
</StarlightPage>
