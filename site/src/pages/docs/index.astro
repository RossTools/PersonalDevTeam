---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { LinkCard, CardGrid } from '@astrojs/starlight/components';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const page = (id: string) => `${base}docs/${id}/`;
---

<StarlightPage frontmatter={{ title: 'PDT docs', description: 'How PDT works: guides and reference.' }}>
	<p>
		PDT (Personal Dev Team) runs coding agents on your machine: you write tickets, agents build, review and test them in
		their own worktrees, and you approve what ships. These pages are the same Markdown the project keeps in its
		repository.
	</p>
	<h2>Guides</h2>
	<CardGrid>
		<LinkCard title="Working in a PDT project" description="How an agent PDT starts finds PDT and uses its tickets, worktrees, runs and tests." href={page('agent-guide')} />
		<LinkCard title="Run configuration" description="What Run and Test do on a branch or worktree, and .pdt/project.toml." href={page('run-config')} />
		<LinkCard title="How we work on PDT" description="The day-to-day lifecycle: branches, checks, the changelog, releases." href={page('sdlc')} />
	</CardGrid>
	<h2>Reference</h2>
	<CardGrid>
		<LinkCard title="Host" description="The daemon, the tray app, releases, updates and remote access." href={page('reference/host')} />
		<LinkCard title="Agent sessions" description="Terminals, instructions, activity, restart and the PM." href={page('reference/agents')} />
		<LinkCard title="Conversations" description="The structured view of an agent session." href={page('reference/conversations')} />
		<LinkCard title="Tickets" description="The board, parts, Start, pull requests and areas." href={page('reference/tickets')} />
		<LinkCard title="Workflows" description="Events, the engine, agent steps, the pipeline and integrations." href={page('reference/workflows')} />
		<LinkCard title="Review" description="The Changes view, line comments, Approve and Merge." href={page('reference/review')} />
		<LinkCard title="Workspaces" description="Projects, worktrees and runs." href={page('reference/workspaces')} />
		<LinkCard title="Secrets" description="Secrets agents and workflows use but never see." href={page('reference/secrets')} />
		<LinkCard title="GitHub" description="The GitHub forge, the in-app login and rate limits." href={page('reference/github')} />
	</CardGrid>
</StarlightPage>
