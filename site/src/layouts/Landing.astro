---
// The frame of the pages outside Starlight (the landing page, Features and Plugins): head, nav and footer.
import '../styles/fonts.css';
import '../styles/landing.css';
import markOnDark from '../assets/pdt-mark-on-dark.svg?url';
import { siteLinks } from '../links.mjs';
import { NAME, SITE_NAME, pageTitle } from '../brand.mjs';

interface Props {
	/** The page's name ("Features"), put before the site name; the landing page leaves it out. */
	title?: string;
	description: string;
}

const { title: page, description } = Astro.props;
const title = pageTitle(page);
const links = siteLinks(import.meta.env.BASE_URL);

// The phone menu's links; it marks the page you're on (a plugin's own page counts as Plugins).
const path = Astro.url.pathname.replace(/\/?$/, '/');
const menu = [
	{ label: 'How it works', href: `${links.home}#how` },
	{ label: 'Features', href: links.features },
	{ label: 'Plugins', href: links.plugins, section: true },
	{ label: 'Docs', href: links.docs },
	{ label: 'Changelog', href: links.changelog },
	{ label: 'GitHub', href: links.github },
].map((l) => ({
	...l,
	current: path === l.href ? 'page' : l.section && path.startsWith(l.href) ? 'true' : undefined,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={`${links.home}pdt-favicon-16.svg`} type="image/svg+xml" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body>
		<nav>
			<div class="wrap">
				<a class="logo" href={links.home}><img src={markOnDark} alt="pdt" /><span class="logo-name">{NAME}</span></a>
				<ul>
					<li><a href={`${links.home}#how`}>How it works</a></li>
					<li><a href={links.features}>Features</a></li>
					<li><a href={links.plugins}>Plugins</a></li>
					<li><a href={links.docs}>Docs</a></li>
					<li><a href={links.changelog}>Changelog</a></li>
				</ul>
				<div class="right">
					<a class="btn sm ghost nav-github" href={links.github}>GitHub</a>
					<a class="btn sm primary" href={links.download}>Download</a>
					<button class="btn sm ghost menu-button" type="button" aria-expanded="false" aria-controls="site-menu">
						<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"
							><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg
						><span class="menu-label">Menu</span>
					</button>
				</div>
			</div>
			<div class="menu-panel" id="site-menu" hidden>
				<ul>
					{menu.map((l) => <li><a href={l.href} aria-current={l.current}>{l.label}</a></li>)}
				</ul>
			</div>
		</nav>

		<slot />

		<footer>
			<div class="wrap">
				<a class="logo" href={links.home}><img src={markOnDark} alt="pdt" /></a>
				<span>{NAME} · Open source under the <a href={links.license}>Apache License 2.0</a></span>
				<div class="links">
					<a href={links.features}>Features</a><a href={links.plugins}>Plugins</a><a href={links.docs}>Docs</a><a href={links.changelog}>Changelog</a><a href={links.github}>GitHub</a><a href={links.privacy}>Privacy</a>
				</div>
			</div>
		</footer>

		<script>
			// The phone menu (below 860 px). Without the script the button stays hidden and the footer has the links.
			const nav = document.querySelector<HTMLElement>('body > nav')!;
			const button = nav.querySelector<HTMLButtonElement>('.menu-button')!;
			const label = button.querySelector<HTMLElement>('.menu-label')!;
			const panel = nav.querySelector<HTMLElement>('#site-menu')!;
			const desktop = window.matchMedia('(min-width: 861px)');

			function setOpen(open: boolean, restoreFocus = true) {
				if (open === !panel.hidden) return;
				panel.hidden = !open;
				button.setAttribute('aria-expanded', String(open));
				label.textContent = open ? 'Close' : 'Menu';
				document.documentElement.classList.toggle('menu-open', open);
				if (open) panel.querySelector<HTMLElement>('a')?.focus();
				else if (restoreFocus) button.focus({ preventScroll: true });
			}

			nav.dataset.menu = 'ready';
			button.addEventListener('click', () => setOpen(panel.hidden));
			// A link closes it before the browser follows it, so a same-page anchor can scroll.
			panel.addEventListener('click', (e) => {
				if ((e.target as Element).closest('a')) setOpen(false, false);
				else if (e.target === panel) setOpen(false);
			});
			document.addEventListener('click', (e) => {
				if (!panel.hidden && !nav.contains(e.target as Node)) setOpen(false);
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !panel.hidden) setOpen(false);
			});
			nav.addEventListener('focusout', (e) => {
				if (!panel.hidden && e.relatedTarget && !nav.contains(e.relatedTarget as Node)) setOpen(false, false);
			});
			desktop.addEventListener('change', () => desktop.matches && setOpen(false, false));
		</script>
	</body>
</html>
