---
// The frame of the pages outside Starlight (the landing page, Features and Plugins): head, nav and footer.
import '../styles/fonts.css';
import '../styles/landing.css';
import markOnDark from '../assets/pdt-mark-on-dark.svg?url';
import { siteLinks } from '../links.mjs';
import { NAME, SITE_NAME, pageTitle } from '../brand.mjs';

interface Props {
	/** The page's name ("Features"), put before the site name; the landing page leaves it out. */
	title?: string;
	description: string;
}

const { title: page, description } = Astro.props;
const title = pageTitle(page);
const links = siteLinks(import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={`${links.home}pdt-favicon-16.svg`} type="image/svg+xml" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body>
		<nav>
			<div class="wrap">
				<a class="logo" href={links.home}><img src={markOnDark} alt="pdt" /><span class="logo-name">{NAME}</span></a>
				<ul>
					<li><a href={`${links.home}#how`}>How it works</a></li>
					<li><a href={links.features}>Features</a></li>
					<li><a href={links.plugins}>Plugins</a></li>
					<li><a href={links.docs}>Docs</a></li>
					<li><a href={links.changelog}>Changelog</a></li>
				</ul>
				<div class="right">
					<a class="btn sm ghost" href={links.github}>GitHub</a>
					<a class="btn sm primary" href={links.download}>Download</a>
				</div>
			</div>
		</nav>

		<slot />

		<footer>
			<div class="wrap">
				<a class="logo" href={links.home}><img src={markOnDark} alt="pdt" /></a>
				<span>{NAME} · Open source</span>
				<div class="links">
					<a href={links.features}>Features</a><a href={links.plugins}>Plugins</a><a href={links.docs}>Docs</a><a href={links.changelog}>Changelog</a><a href={links.github}>GitHub</a>
				</div>
			</div>
		</footer>
	</body>
</html>
