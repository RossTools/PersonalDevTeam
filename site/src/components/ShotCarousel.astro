---
// The landing page's screenshot carousel. The slides are a row that scrolls and snaps, so without JS (or on touch)
// they still scroll and swipe; the script adds the buttons, dots and arrow keys. No autoplay. Every slide's image sits
// in a frame of the same shape (the board's 2:1, taller shots cropped at the bottom), so the carousel's height never
// changes between slides. On phones the frames are taller (4:5) and every shot fills its frame at a readable size: a
// desktop shot shows the part at its `detail` (an object-position), and the `phone` slide, a phone's capture, comes
// first (CSS `order`, so the script follows the slides' order on screen, not in the page).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	label: string;
	slides: { src: ImageMetadata; title: string; text: string; alt: string; detail?: string; phone?: boolean }[];
}

const { label, slides } = Astro.props;
---

<div class="carousel" role="region" aria-roledescription="carousel" aria-label={label}>
	<div class="carousel-track" tabindex="0" aria-live="off">
		{slides.map((slide, i) => (
			<figure class:list={['carousel-slide', { phone: slide.phone }]} role="group" aria-roledescription="slide" data-title={slide.title} aria-label={`${i + 1} of ${slides.length}: ${slide.title}`}>
				<div class="shot carousel-frame" style={slide.detail && `--detail: ${slide.detail}`}>
					<Image
						src={slide.src}
						alt={slide.alt}
						widths={slide.phone ? [400, 800, 1170] : [640, 1040, 1600, 2080]}
						sizes={slide.phone ? '(max-width: 640px) calc(100vw - 48px), 240px' : `(max-width: 640px) calc(${(1.25 * slide.src.width / slide.src.height).toFixed(2)} * (100vw - 48px)), (max-width: 1088px) calc(100vw - 48px), 1040px`}
						loading={i === 0 ? 'eager' : 'lazy'}
					/>
				</div>
				<figcaption><b>{slide.title}</b>{slide.text}</figcaption>
			</figure>
		))}
	</div>
	<div class="carousel-nav" hidden>
		<button type="button" class="carousel-btn" data-step="-1" aria-label="Previous screenshot">‹</button>
		<div class="carousel-dots">
			{slides.map((slide, i) => (
				<button type="button" class:list={['carousel-dot', { phone: slide.phone }]} aria-label={`Show ${slide.title}`}></button>
			))}
		</div>
		<button type="button" class="carousel-btn" data-step="1" aria-label="Next screenshot">›</button>
	</div>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('.carousel')) {
		const track = root.querySelector<HTMLElement>('.carousel-track')!;
		const all = [...track.querySelectorAll<HTMLElement>('.carousel-slide')];
		const dots = [...root.querySelectorAll<HTMLButtonElement>('.carousel-dot')];
		// The slides in their order on screen (phones put the phone's first), numbered in that order for screen readers.
		let slides = all;
		const order = () => {
			slides = [...all].sort((a, b) => a.offsetLeft - b.offsetLeft);
			slides.forEach((s, i) => s.setAttribute('aria-label', `${i + 1} of ${slides.length}: ${s.dataset.title}`));
		};
		const [prev, next] = root.querySelectorAll<HTMLButtonElement>('.carousel-btn');
		const nav = root.querySelector<HTMLElement>('.carousel-nav')!;
		const still = matchMedia('(prefers-reduced-motion: reduce)');
		let current = 0;

		const show = (i: number) => {
			current = Math.max(0, Math.min(slides.length - 1, i));
			track.scrollTo({ left: slides[current].offsetLeft - track.offsetLeft, behavior: still.matches ? 'auto' : 'smooth' });
			mark();
		};
		const mark = () => {
			slides.forEach((s, i) => s.toggleAttribute('inert', i !== current));
			dots.forEach((d, i) => d.toggleAttribute('aria-current', all[i] === slides[current]));
			prev.disabled = current === 0;
			next.disabled = current === slides.length - 1;
		};

		prev.addEventListener('click', () => show(current - 1));
		next.addEventListener('click', () => show(current + 1));
		dots.forEach((d, i) => d.addEventListener('click', () => show(slides.indexOf(all[i]))));
		root.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') show(current - 1);
			else if (e.key === 'ArrowRight') show(current + 1);
			else return;
			e.preventDefault();
		});
		// A swipe or a scroll snaps to a slide: follow it. A scroll from a resize (the track's width changed) is left to
		// the resize below, which keeps the slide that was in view.
		let width = track.clientWidth;
		track.addEventListener('scroll', () => {
			if (track.clientWidth !== width) return;
			const i = Math.round(track.scrollLeft / track.clientWidth);
			if (i !== current && i >= 0 && i < slides.length) {
				current = i;
				mark();
			}
		}, { passive: true });

		// A resize moves the slides, and crossing the phone breakpoint reorders them: keep the one in view.
		new ResizeObserver(() => {
			if (track.clientWidth === width) return;
			width = track.clientWidth;
			const shown = slides[current];
			order();
			current = slides.indexOf(shown);
			track.scrollTo({ left: shown.offsetLeft - track.offsetLeft });
			mark();
		}).observe(track);

		nav.hidden = false;
		root.classList.add('ready');
		order();
		mark();
	}
</script>
