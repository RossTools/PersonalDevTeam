---
// The footer of the pages outside Starlight.
import markOnDark from '../assets/pdt-mark-on-dark.svg?url';
import { siteLinks } from '../links.mjs';

const links = siteLinks(import.meta.env.BASE_URL);
---

<footer>
	<div class="wrap">
		<a class="logo" href={links.root}><img src={markOnDark} alt="pdt" /></a>
		<span>Personal Dev Team · Open source</span>
		<div class="links">
			<a href={links.plugins}>Plugins</a><a href={links.docs}>Docs</a><a href={links.changelog}>Changelog</a><a href={links.github}>GitHub</a>
		</div>
	</div>
</footer>
