{
  "name": "PDT missing nightly",
  "description": "Every day at 10:00 UTC, about two hours after the release workflow's nightly schedule, looks for the day's nightly release of RossTools/PersonalDevTeam. When main changed since the last one and none is published, the Inbox says so, with Start it; the item closes by itself once a nightly is published. Days main didn't change say nothing.",
  "nodes": [
    {
      "id": "daily",
      "kind": "schedule",
      "version": 1,
      "title": "Every day",
      "config": {
        "catchUp": true,
        "cron": "0 10 * * *",
        "timezone": "UTC"
      },
      "position": {
        "x": 0.0,
        "y": 0.0
      }
    },
    {
      "id": "watch",
      "kind": "github.nightly",
      "version": 1,
      "title": "The day's nightly",
      "config": {
        "branch": "main",
        "day": "{{trigger.date}}",
        "dueHour": 10,
        "repo": "RossTools/PersonalDevTeam",
        "workflow": "release.yml"
      },
      "position": {
        "x": 260.0,
        "y": 0.0
      },
      "retry": {
        "max": 5,
        "backoffMs": 60000
      }
    },
    {
      "id": "start",
      "kind": "github.workflow.run",
      "version": 1,
      "title": "Run the release workflow (nightly)",
      "config": {
        "inputs": {
          "channel": "nightly"
        },
        "ref": "main",
        "repo": "RossTools/PersonalDevTeam",
        "workflow": "release.yml"
      },
      "position": {
        "x": 520.0,
        "y": -160.0
      }
    },
    {
      "id": "started",
      "kind": "notify",
      "version": 1,
      "title": "Tell me it started",
      "config": {
        "body": "The release workflow runs on main with channel nightly; PDT nightly release reports it if it fails.",
        "link": "{{steps.watch.runsUrl}}",
        "title": "Tonight's nightly is starting"
      },
      "position": {
        "x": 780.0,
        "y": -160.0
      }
    },
    {
      "id": "start_failed",
      "kind": "inbox.notice",
      "version": 1,
      "title": "Inbox: it would not start",
      "config": {
        "key": "nightly-start-failed-{{steps.watch.day}}",
        "text": "PDT could not run the release workflow: {{steps.start.error}}\n\nStart it on GitHub instead: [the release workflow]({{steps.watch.runsUrl}}), Run workflow on main with channel `nightly`.",
        "title": "Tonight's nightly didn't start"
      },
      "position": {
        "x": 780.0,
        "y": -320.0
      }
    },
    {
      "id": "done",
      "kind": "end",
      "version": 1,
      "title": "Started",
      "config": null,
      "position": {
        "x": 1040.0,
        "y": -160.0
      }
    },
    {
      "id": "fine",
      "kind": "end",
      "version": 1,
      "title": "Fine",
      "config": {
        "quiet": true
      },
      "position": {
        "x": 520.0,
        "y": 160.0
      }
    }
  ],
  "edges": [
    {
      "from": "daily",
      "port": "out",
      "to": "watch"
    },
    {
      "from": "watch",
      "port": "start",
      "to": "start"
    },
    {
      "from": "start",
      "port": "out",
      "to": "started"
    },
    {
      "from": "start",
      "port": "error",
      "to": "start_failed"
    },
    {
      "from": "started",
      "port": "out",
      "to": "done"
    },
    {
      "from": "start_failed",
      "port": "added",
      "to": "done"
    },
    {
      "from": "start_failed",
      "port": "skipped",
      "to": "done"
    },
    {
      "from": "watch",
      "port": "published",
      "to": "fine"
    },
    {
      "from": "watch",
      "port": "early",
      "to": "fine"
    },
    {
      "from": "watch",
      "port": "unchanged",
      "to": "fine"
    },
    {
      "from": "watch",
      "port": "ignore",
      "to": "fine"
    },
    {
      "from": "watch",
      "port": "already",
      "to": "fine"
    },
    {
      "from": "watch",
      "port": "expired",
      "to": "fine"
    }
  ],
  "settings": {
    "maxSteps": 200,
    "maxRuntimeMs": 604800000
  }
}
