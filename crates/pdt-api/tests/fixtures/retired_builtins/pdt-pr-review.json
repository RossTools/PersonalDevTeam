        ]
      },
      "position": {
        "x": 540.0,
        "y": 80.0
      }
    },
    {
      "id": "already_done",
      "kind": "end",
      "version": 1,
      "title": "Already finished",
      "config": {
        "quiet": true
      },
      "position": {
        "x": 800.0,
        "y": -60.0
      }
    },
    {
      "id": "dependabot",
      "kind": "condition",
      "version": 1,
      "title": "Dependabot update to merge?",
      "config": {
        "conditions": [
          {
            "left": true,
            "op": "truthy"
          },
          {
            "left": "{{trigger.kind}}",
            "op": "eq",
            "right": "bot"
          },
          {
            "left": "{{trigger.author}}",
            "op": "eq",
            "right": "dependabot[bot]"
          },
          {
            "left": "{{trigger.updateType}}",
            "op": "in",
            "right": [
              "patch",
              "minor"
            ]
          }
        ]
      },
      "position": {
        "x": 800.0,
        "y": 80.0
      }
    },
    {
      "id": "wait_ci",
      "kind": "wait",
      "version": 1,
      "title": "Wait for CI",
      "config": {
        "ms": 120000
      },
      "position": {
        "x": 1060.0,
        "y": -100.0
      },
      "maxVisits": 360
    },
    {
      "id": "check_ci",
      "kind": "github.change_request",
      "version": 1,
      "title": "CI on its head",
      "config": {
        "branch": "{{trigger.headBranch}}",
        "ci": true,
        "dryRunPort": "open",
        "number": "{{trigger.number}}",
        "repo": "{{trigger.repo}}"
      },
      "position": {
        "x": 1320.0,
        "y": -100.0
      },
      "retry": {
        "max": 5,
        "backoffMs": 60000
      },
      "maxVisits": 360
