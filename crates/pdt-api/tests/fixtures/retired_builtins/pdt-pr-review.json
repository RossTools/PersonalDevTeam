      "kind": "end",
      "version": 1,
      "title": "Merged or closed meanwhile",
      "config": {
        "quiet": true
      },
      "position": {
        "x": 1580.0,
        "y": -260.0
      }
    },
    {
      "id": "blocked",
      "kind": "gate",
      "version": 1,
      "title": "Didn't merge: ask me",
      "config": {
        "choices": [
          "approve_merge",
          "request_changes",
          "close"
        ],
        "event": {
          "also": [
            "github.pull_request.closed"
          ],
          "type": "github.pull_request.pushed",
          "where": [
            {
              "left": "{{event.repo}}",
              "op": "eq",
              "right": "{{trigger.repo}}"
            },
            {
              "left": "{{event.number}}",
              "op": "eq",
              "right": "{{trigger.number}}"
            }
          ]
        },
        "question": "**[{{trigger.repo}}#{{trigger.number}}]({{trigger.url}})** by {{trigger.author}} didn't merge: {{trigger.title}}\n\nCI on its head: {{steps.check_ci.ci}} {{steps.check_ci.ciUrl}}\n{{steps.check_ci.failedJobs}}\n\n{{steps.merge.reason}}\n\n{{steps.review.summary}}\n\nApprove & merge tries again once CI passes. Request changes posts your note on it as a review. Close closes it.",
        "ticket": "{{steps.ticket.ticketId}}"
      },
      "position": {
        "x": 2100.0,
        "y": -360.0
      },
      "maxVisits": 10
    },
    {
      "id": "blocked_request",
      "kind": "github.pr.review",
      "version": 1,
      "title": "Request changes",
      "config": {
        "body": "{{steps.blocked.text}}",
        "fallback": "This pull request can't merge yet: {{steps.merge.reason}} {{steps.check_ci.ciUrl}}",
        "number": "{{trigger.number}}",
        "repo": "{{trigger.repo}}",
        "verdict": "request_changes"
      },
      "position": {
        "x": 2360.0,
        "y": -480.0
      },
      "maxVisits": 10
    },
