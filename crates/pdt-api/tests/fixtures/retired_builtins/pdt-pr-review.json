      "config": {
        "author": "{{trigger.author}}",
        "body": "{{trigger.body}}",
        "number": "{{trigger.number}}",
        "project": "{{trigger.projectId}}",
        "repo": "{{trigger.repo}}",
        "title": "{{trigger.title}}",
        "url": "{{trigger.url}}"
      },
      "position": {
        "x": 280.0,
        "y": 80.0
      }
    },
    {
      "id": "finished",
      "kind": "condition",
      "version": 1,
      "title": "Ticket finished?",
      "config": {
        "conditions": [
          {
            "left": "{{steps.ticket.closed}}",
            "op": "truthy"
