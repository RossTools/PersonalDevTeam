{
  "name": "Cut a release",
  "description": "Runs the project's release workflow (release.yml) with a bump kind (patch, minor or major) or an exact version: it opens a release PR that sets the version, compiles the changelog and builds the bundles, and merges itself once its checks pass, which tags and publishes the release. You are told when the PR is open and when the release is out; a failed check goes to the Inbox (the PR stays open: push a fix to the release branch, or close it). With channel nightly there is no release PR: it publishes a nightly build of main's head now (X.Y.Z-nightly.YYYYMMDD, a pre-release, as the release workflow makes every night) that only hosts on the nightly update channel install, and you are told when it is out. Run it (the PM does, when you ask for a release) with input {\"bump\": \"minor\", \"channel\": \"stable\", \"projectId\": \u2026}.",
  "nodes": [
    {
      "id": "start",
      "kind": "manual",
      "version": 1,
      "title": "Cut a release",
      "config": null,
      "position": {
        "x": -260.0,
        "y": 0.0
      }
    },
    {
      "id": "channel",
      "kind": "condition",
      "version": 1,
      "title": "Nightly?",
      "config": {
        "conditions": [
          {
            "left": "{{trigger.channel}}",
            "op": "in",
            "right": [
              "nightly",
              "experimental"
            ]
          }
        ]
      },
      "position": {
        "x": 0.0,
        "y": 0.0
      }
    },
    {
      "id": "nightly_before",
      "kind": "github.release",
      "version": 1,
      "title": "Newest release before",
      "config": {
        "prereleases": true
      },
      "position": {
        "x": 260.0,
        "y": -260.0
      },
      "retry": {
        "max": 5,
        "backoffMs": 60000
      }
    },
    {
      "id": "nightly_dispatch",
      "kind": "github.workflow.run",
      "version": 1,
      "title": "Run the release workflow (nightly)",
      "config": {
        "inputs": {
          "bump": "{{trigger.bump}}",
          "channel": "nightly",
          "version": "{{trigger.version}}"
        },
        "ref": "main",
        "workflow": "release.yml"
      },
      "position": {
        "x": 520.0,
        "y": -260.0
      }
    },
    {
      "id": "wait_nightly",
      "kind": "wait",
      "version": 1,
      "title": "Wait for the pre-release",
      "config": {
        "ms": 120000
      },
      "position": {
        "x": 780.0,
        "y": -260.0
      },
      "maxVisits": 120
    },
    {
      "id": "nightly_published",
      "kind": "github.release",
      "version": 1,
      "title": "Pre-release published?",
      "config": {
        "newerThan": "{{steps.nightly_before.tag}}",
        "prereleases": true
      },
      "position": {
        "x": 1040.0,
        "y": -260.0
      },
      "retry": {
        "max": 5,
        "backoffMs": 60000
      },
      "maxVisits": 120
    },
    {
      "id": "nightly_notify",
      "kind": "notify",
      "version": 1,
      "title": "Tell me it is out",
      "config": {
        "body": "{{steps.nightly_published.name}} is out as a pre-release; hosts on the nightly update channel offer it.",
        "link": "{{steps.nightly_published.url}}",
        "title": "Nightly release {{steps.nightly_published.tag}} is published"
      },
      "position": {
        "x": 1300.0,
        "y": -260.0
      }
    },
    {
      "id": "nightly_tell",
      "kind": "inbox.notice",
      "version": 1,
      "title": "Inbox: published",
      "config": {
        "key": "released-{{steps.nightly_published.tag}}",
        "text": "[{{steps.nightly_published.name}}]({{steps.nightly_published.url}}) is published as a pre-release of main, with its bundles: hosts on the nightly update channel (Settings \u2192 Updates) offer it, stable hosts ignore it.",
        "title": "Nightly release {{steps.nightly_published.tag}} is published"
      },
      "position": {
        "x": 1560.0,
        "y": -260.0
      }
    },
    {
      "id": "nightly_released",
      "kind": "end",
      "version": 1,
